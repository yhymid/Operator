[Unit]
Description=Operator Discord bot (Rust)
# After the local Lavalink node; no hard link, so a Lavalink restart does not restart the bot.
After=network-online.target lavalink.service
Wants=network-online.target lavalink.service
# Webhook notification, see scripts/ops/README.md (harmless if the template is not installed).
OnFailure=operator-notify@%n.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/operator/app
EnvironmentFile=/srv/operator/app/.env
ExecStart=/srv/operator/app/operator-discord
Restart=always
RestartSec=5
KillSignal=SIGINT
# SIGINT only to the bot; yt-dlp/ffmpeg children get SIGKILL only if still alive at the timeout.
KillMode=mixed
Nice=5
# /tmp is tmpfs on the VPS: keep downloaded videos on disk, not in RAM.
Environment=TMPDIR=/var/tmp
TimeoutStopSec=20
# New files private to the bot user (the website that serves /ytdlp media runs as the same user).
UMask=0077
SyslogIdentifier=operator

[Install]
WantedBy=multi-user.target
