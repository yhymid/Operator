[Unit]
Description=Operator Telegram bot (Rust)
After=network-online.target telegram-bot-api.service
Wants=network-online.target
# Webhook notification, see scripts/ops/README.md (harmless if the template is not installed).
OnFailure=operator-notify@%n.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/yhymfiles/operator-tg
ExecStart=/home/ubuntu/yhymfiles/operator-tg/operator-telegram
Restart=always
RestartSec=5
KillSignal=SIGINT
# SIGINT only to the bot; yt-dlp/ffmpeg children get SIGKILL only if still alive at the timeout.
KillMode=mixed
Nice=5
# /tmp is tmpfs on the VPS: keep downloaded videos on disk, not in RAM.
Environment=TMPDIR=/var/tmp
TimeoutStopSec=30
# New files private to the bot user (the website that serves published media runs as the same user).
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
