BOT_TOKEN=your_discord_bot_token
OWNER_IDS=111111111111111111,222222222222222222
# Optional single-owner alias:
# OWNER_ID=111111111111111111

# Optional runtime paths. On VPS it is recommended to move data/logs outside the repo.
# OPERATOR_CONFIG_PATH=/srv/operator/app/config.json
# OPERATOR_DATA_DIR=/srv/operator/data
# OPERATOR_LOG_DIR=/srv/operator/logs
# OPERATOR_SYNC_COMMANDS_ON_STARTUP=false

# Lavalink v4 connection
# LAVALINK_URL=lavalink://operator-main:youshallnotpass@127.0.0.1:2333
# or configure the node with separate values:
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
LAVALINK_NODE_ID=operator-main

# Default source for text search. Good values: ytmsearch, ytsearch, scsearch.
LAVALINK_SEARCH_SOURCE=ytmsearch
LAVALINK_VOLUME=100
# Rozlaczenie po pustej kolejce i gdy na kanale nie zostal nikt poza botami (ms, 0 = nigdy).
# MUSIC_IDLE_DISCONNECT_MS=120000
# MUSIC_ALONE_DISCONNECT_MS=60000

# /ytdlp
# YTDLP_PATH=/usr/local/bin/yt-dlp
# YTDLP_COOKIES_PATH=./cookies.txt
# Runtime JS do wyzwan YouTube (yt-dlp sam szuka tylko deno).
# YTDLP_JS_RUNTIME=node
# Odrzuca filmy dluzsze niz tyle sekund i przerywa pobieranie wiekszych plikow (0 = bez limitu).
# YTDLP_MAX_DURATION_SECONDS=1800
# YTDLP_MAX_DOWNLOAD_BYTES=1073741824
# Wieksze pliki ida na strone jako player (link wazny 6 godzin).
# YTDLP_MAX_UPLOAD_BYTES=26214400
# YTDLP_MEDIA_ROOT=/home/ubuntu/Main Files/website/media
# YTDLP_MEDIA_BASE_URL=https://bladephoriafonk.xyz/media
# Kodek wysylanego video: av1 (domyslnie, mniejsze pliki, sprawdzone w Discordzie),
# h264 (najszersza zgodnosc, wieksze pliki), source (bez konwersji - HEVC sie zacina).
# YTDLP_VIDEO_CODEC=av1
# CRF: domyslnie 30 dla AV1, 18 dla H.264 (mniej = lepiej i wiekszy plik).
# YTDLP_VIDEO_CRF=30
# Preset SVT-AV1: 0 (najwolniej, najlepiej) .. 13 (najszybciej). 10 ~3x szybciej niz 6 przy ~11% wiekszym pliku.
# YTDLP_AV1_PRESET=10
# Na co przerabiac HEVC/VP9/10-bit (HEVC nie gra w Discordzie na PC): h264 (domyslnie, szybciej
# i blizej oryginalu, plik wiekszy) albo av1 (mniejszy plik, wolniej).
# YTDLP_REENCODE_CODEC=h264
# Preset x264: ultrafast .. veryslow. veryfast ~3.5x szybciej niz slow przy prawie tej samej jakosci.
# YTDLP_X264_PRESET=veryfast
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Diagnostyka 24/7: kazde zdarzenie i linia logu (bez tokenow i hasel) w
# diagnostics/events-RRRR-MM-DD.txt, raport opoznien co 15 min w diagnostics/summary-RRRR-MM-DD.md.
# OPERATOR_DIAGNOSTICS=1
# OPERATOR_DIAGNOSTICS_DIR=diagnostics
# OPERATOR_DIAGNOSTICS_RETENTION_DAYS=14
# OPERATOR_DIAGNOSTICS_MAX_FILE_MB=256
# OPERATOR_DIAGNOSTICS_SUMMARY_MINUTES=15
