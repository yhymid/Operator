server:
  port: 2333
  address: 127.0.0.1

lavalink:
  server:
    password: "youshallnotpass"
    sources:
      youtube: false
      bandcamp: true
      soundcloud: true
      twitch: true
      vimeo: true
      nico: true
      http: true
      local: false
    # Audio buffered before a track starts or after a seek. Lower = faster start; raise it
    # (e.g. 400) if playback stutters on a slow connection.
    bufferDurationMs: 225
    frameBufferDurationMs: 5000
    youtubePlaylistLoadLimit: 100
    playerUpdateInterval: 5
    opusEncodingQuality: 10
    resamplingQuality: HIGH
    trackStuckThresholdMs: 10000
    useSeekGhosting: true

  plugins:
    # YouTube support for Lavalink v4: https://github.com/lavalink-devs/youtube-source
    # Use a snapshot (= build of a master commit): release 1.18.2 (2026-07) misses the fixes
    # that make YouTube playable from a VPS (TV client User-Agent, IOS, visitor data refresh).
    # Latest hash: <latest> in
    # https://maven.lavalink.dev/snapshots/dev/lavalink/youtube/youtube-plugin/maven-metadata.xml
    - dependency: "dev.lavalink.youtube:youtube-plugin:e41dd95f8bd134b51e75080fb28cc805fecb431a"
      snapshot: true

    # Spotify / Apple Music / Deezer metadata and sources:
    # https://github.com/topi314/LavaSrc
    - dependency: "com.github.topi314.lavasrc:lavasrc-plugin:4.8.3"
      snapshot: false

    # Lyrics for the "Lyrics" button: https://github.com/topi314/LavaLyrics
    - dependency: "com.github.topi314.lavalyrics:lavalyrics-plugin:1.1.0"
      snapshot: false

    # Extra audio filters (Normalize and Echo in the FX menu):
    # https://github.com/devoxin/LavaDSPX-Plugin
    - dependency: "com.github.devoxin:lavadspx-plugin:0.0.5"
      repository: "https://jitpack.io"

plugins:
  youtube:
    enabled: true
    allowSearch: true
    allowDirectVideoIds: true
    allowDirectPlaylistIds: true
    clients:
      - TV
      - TVHTML5_SIMPLY
      - IOS
      - ANDROID_VR
      - WEB
      - WEBEMBEDDED
      - MWEB
      - MUSIC
    # TV playback needs OAuth. First start without refreshToken: follow the device-code
    # instructions in the Lavalink log, then paste the printed refresh token here.
    oauth:
      enabled: true
      refreshToken: "${YOUTUBE_OAUTH_REFRESH_TOKEN:}"
    # Signature deciphering is no longer done inside the plugin.
    remoteCipher:
      url: "https://cipher.kikkia.dev/"
      userAgent: "operator-bot"

  lavalyrics:
    # Order in which the lyrics sources are asked.
    sources:
      - lrcLib
      - youtube

  lavasrc:
    # Where Spotify (and other metadata-only) tracks are actually played from, first match
    # wins. With Deezer enabled (see below) put these two first for FLAC / MP3 320 audio:
    #   - "dzisrc:%ISRC%"
    #   - "dzsearch:%QUERY%"
    providers:
      - "ytsearch:\"%ISRC%\""
      - "scsearch:%QUERY%"
      - "ytsearch:%QUERY%"
      - "ytmsearch:%QUERY%"
    # Keep LavaSrc's ytdlp source disabled: it registers before the YouTube plugin and would
    # take over every YouTube URL.
    sources:
      spotify: true
      applemusic: false
      deezer: false
      youtube: false
    lyrics-sources:
      lrcLib: true      # https://lrclib.net, no account needed
      youtube: true
    spotify:
      clientId: "SPOTIFY_CLIENT_ID"
      clientSecret: "SPOTIFY_CLIENT_SECRET"
      countryCode: "PL"
      playlistLoadLimit: 6
      albumLoadLimit: 6
      preferAnonymousToken: false
      # Optional: for Spotify-generated playlists you may still need this:
      # customTokenEndpoint: "http://localhost:8080/api/token"
    deezer:
      masterDecryptionKey: "${DEEZER_MASTER_KEY:}"
      arl: "${DEEZER_ARL:}"
      formats: [ "FLAC", "MP3_320", "MP3_256", "MP3_128", "MP3_64", "AAC_64" ]
      # Deezer plays FLAC / MP3 320 (best source quality). It needs both values in the
      # environment of lavalink.service: DEEZER_ARL (the `arl` cookie of a logged-in Deezer
      # account; FLAC and 320 need a paid plan) and DEEZER_MASTER_KEY (the track decryption
      # key, not distributed with LavaSrc). Then set sources.deezer=true above and add the two
      # dz providers. Discord still sends Opus at the channel bitrate (96-384 kb/s).

logging:
  file:
    path: ./logs/
  level:
    root: INFO
    lavalink: INFO
    dev.lavalink.youtube.http.YoutubeOauth2Handler: INFO
