// polkit rule: lets the bot user start the four update units used by /update on Discord, and
// nothing else. Install as /etc/polkit-1/rules.d/50-operator-update.rules and change "ubuntu"
// if the bot runs as another user. systemd passes the unit name and verb as action details.
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units" || subject.user !== "ubuntu") {
        return polkit.Result.NOT_HANDLED;
    }
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    if (verb === "start" && /^operator-update@(ytdlp|lavalink|server|operator)\.service$/.test(unit)) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
