TELEGRAM_BOT_TOKEN=tu_wklej_token_od_BotFather
# Po uruchomieniu Local Bot API Server ustaw na http://127.0.0.1:8081
TELEGRAM_API_ROOT=https://api.telegram.org
# Administratorzy: numeryczne Telegram user ID, rozdzielone spacją/przecinkiem
# (nazwy użytkowników nie są obsługiwane - można je zwolnić i przejąć)
ADMIN_IDS=
YTDLP_COOKIES_PATH=./cookies.txt
# 49 MB — margines poniżej limitu Bot API (50 MB)
YTDLP_MAX_UPLOAD_BYTES=49000000
YTDLP_TIMEOUT_SECONDS=900
YTDLP_PROGRESS_INTERVAL_MS=2500
TELEGRAM_HANDLER_TIMEOUT_MS=1800000
# Kodek wysyłanego wideo: h264 (domyślnie, działa w Discordzie/Telegramie/przeglądarce),
# av1 (mniejsze pliki, odtwarzanie w Discordzie niegwarantowane), source (bez konwersji)
YTDLP_VIDEO_CODEC=h264
# Jakość konwersji (CRF): domyślnie 18 dla H.264, 30 dla AV1. Mniej = lepiej i większy plik.
#YTDLP_VIDEO_CRF=18
#FFMPEG_PATH=ffmpeg
#FFPROBE_PATH=ffprobe
# Priorytet kolejki: mniejszy szacowany plik jest obsługiwany wcześniej
YTDLP_QUEUE_SIZE_PROBE=true
YTDLP_QUEUE_PROBE_TIMEOUT_SECONDS=30
# Limit aktywnych zadań w jednej, wspólnej kolejce bota
YTDLP_QUEUE_CONCURRENCY=1
YTDLP_QUEUE_MAX_PENDING=20
# Odrzucaj wiadomości Telegrama dostarczone z opóźnieniem większym niż 10 minut.
YTDLP_MAX_MESSAGE_AGE_SECONDS=600
# Minimalny odstęp między żądaniami wychodzącymi do tego samego czatu.
TELEGRAM_CHAT_MIN_INTERVAL_MS=3000
TELEGRAM_RATE_LIMIT_RETRIES=5
TELEGRAM_RATE_LIMIT_JITTER_MS=1000
# Najpierw pozwól Telegramowi pobrać publiczny URL (tylko gdy strumień ma już docelowy kodek)
TELEGRAM_DIRECT_URL_FIRST=true
# Szczegółowe logi aktualizacji, yt-dlp i uploadu
DEVELOPER_MODE=false
# Pliki ponad limit Telegrama trafiają na stronę jako player (katalog <root>/media).
# Domyślnie katalog "website" obok katalogu bota.
# YTDLP_WEBSITE_ROOT=../website
# YTDLP_PUBLIC_BASE_URL=https://example.com
# Po ilu godzinach strona z plikiem jest usuwana
# YTDLP_WEBSITE_TTL_HOURS=24
