BOT_TOKEN=your_discord_bot_token
OWNER_IDS=780552865445969920,752986566426624061
# Optional single-owner alias:
# OWNER_ID=780552865445969920

# Optional runtime paths. On VPS it is recommended to move data/logs outside the repo.
# OPERATOR_CONFIG_PATH=/srv/operator/app/config.json
# OPERATOR_DATA_DIR=/srv/operator/data
# OPERATOR_LOG_DIR=/srv/operator/logs
# OPERATOR_SYNC_COMMANDS_ON_STARTUP=false

# Lavalink v4 connection
# LAVALINK_URL=lavalink://operator-main:youshallnotpass@127.0.0.1:2333
# or configure the node with separate values:
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
LAVALINK_NODE_ID=operator-main

# Default source for text search. Good values: ytmsearch, ytsearch, scsearch.
LAVALINK_SEARCH_SOURCE=ytmsearch
LAVALINK_VOLUME=80

# /ytdlp
# YTDLP_PATH=/usr/local/bin/yt-dlp
# YTDLP_COOKIES_PATH=./cookies.txt
# Runtime JS do wyzwan YouTube (yt-dlp sam szuka tylko deno).
# YTDLP_JS_RUNTIME=node
# Wieksze pliki ida na strone jako player (link wazny 6 godzin).
# YTDLP_MAX_UPLOAD_BYTES=26214400
# YTDLP_MEDIA_ROOT=/home/ubuntu/Main Files/website/media
# YTDLP_MEDIA_BASE_URL=https://bladephoriafonk.xyz/media
# Kodek wysylanego video: av1 (domyslnie, mniejsze pliki, sprawdzone w Discordzie),
# h264 (najszersza zgodnosc, szybsze kodowanie), source (bez konwersji - HEVC sie zacina).
# YTDLP_VIDEO_CODEC=av1
# CRF: domyslnie 30 dla AV1, 18 dla H.264 (mniej = lepiej i wiekszy plik).
# YTDLP_VIDEO_CRF=30
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
