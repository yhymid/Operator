[Unit]
Description=Operator Discord bot (Rust)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/operator/app
EnvironmentFile=/srv/operator/app/.env
ExecStart=/srv/operator/app/operator-discord
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20
SyslogIdentifier=operator

[Install]
WantedBy=multi-user.target
